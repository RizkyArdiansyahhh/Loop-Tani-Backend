// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image          String?
  avatarPublicId String?
  phone         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  roles         UserRole[]
  sellerProfile SellerProfile?
  products      Product[]
  favorites     ProductFavorite[]
  cart          Cart?
  pointAccount      UserPointAccount?
  pointTransactions PointTransaction[]
  learningProgress  LearningProgress[]
  authoredContent   KnowledgeContent[]
  comments          Comment[]
  commentReports    CommentReport[]
  chatConversations ChatConversation[]
  addresses         Address[]
  buyerOrders       Order[]             @relation("BuyerOrders")
  sellerOrders      Order[]             @relation("SellerOrders")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model SellerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  storeName   String
  storeSlug   String   @unique
  description String?

  province    String?
  city        String?
  address     String?
  postalCode  String?
  phone       String?

  logoUrl      String?
  logoPublicId String?
  bannerUrl    String?

  status           SellerStatus @default(PENDING)
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  socialMedia SellerSocialMedia[]

  @@index([storeSlug])
  @@index([status])
}

model SellerSocialMedia {
  id        String @id @default(uuid())
  sellerId  String

  platform  SocialPlatform
  url       String

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, platform])
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  X
  WHATSAPP
  WEBSITE
  TELEGRAM
}

// ─────────────────────────────────────────────
// Product Enums
// ─────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}

enum ProductCondition {
  NEW
  USED
}

// ─────────────────────────────────────────────
// Category Enum
// ─────────────────────────────────────────────

enum ProductCategory {
  AGRICULTURAL_WASTE @map("agricultural-waste")
  PROCESSED_PRODUCT  @map("processed-product")
  SECONDHAND         @map("secondhand")
}

// ─────────────────────────────────────────────
// Product
// ─────────────────────────────────────────────

model Product {
  id            String           @id @default(uuid())
  sellerId      String
  title         String
  slug          String           @unique
  description   String
  price         Float
  stock         Int              @default(0)
  condition     ProductCondition @default(NEW)
  status        ProductStatus    @default(DRAFT)
  isFeatured    Boolean          @default(false)
  province      String?
  city          String?
  sellerRating  Float            @default(0.0)
  totalReview   Int              @default(0)
  category      String
  unit          String           @default("kg")
  weight        Int              @default(1000)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  seller    User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  images    ProductImage[]
  favorites ProductFavorite[]
  cartItems CartItem[]

  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@index([slug])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductFavorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// Auth Models (managed by better-auth)
// ─────────────────────────────────────────────

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────
// Cart & Cart Items
// ─────────────────────────────────────────────

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// Knowledge Center & Gamification Models
// ─────────────────────────────────────────────

enum ContentType {
  ARTICLE
  VIDEO
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum ContentCategory {
  LIMBAH   @map("limbah")
  OLAHAN   @map("olahan")
  ALAT     @map("alat")
}

enum ContentDifficulty {
  PEMULA    @map("pemula")
  MENENGAH  @map("menengah")
}

enum PointTransactionType {
  EARN
  REDEEM
}

enum PointTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model KnowledgeContent {
  id                      String            @id @default(uuid())
  type                    ContentType
  title                   String
  slug                    String            @unique
  content                 String
  category                String
  difficulty              ContentDifficulty
  imageUrl                String?
  rewardPoint             Int               @default(20)
  estimatedReadingMinutes Int?
  videoDuration           Int?
  cloudinaryPublicId      String?
  secureUrl               String?
  thumbnailUrl            String?
  status                  ContentStatus     @default(DRAFT)
  authorId                String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  author           User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  learningProgress LearningProgress[]
  comments         Comment[]

  @@index([authorId])
  @@index([status])
  @@index([slug])
}

model UserPointAccount {
  id            String    @id @default(uuid())
  userId        String    @unique
  totalPoint    Int       @default(0)
  lifetimePoint Int       @default(0)
  tier          PointTier @default(BRONZE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PointTransaction {
  id          String               @id @default(uuid())
  userId      String
  amount      Int
  type        PointTransactionType
  description String
  sourceId    String?
  sourceType  String?
  createdAt   DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LearningProgress {
  id                   String   @id @default(uuid())
  userId               String
  contentId            String
  scrollPercentage     Float    @default(0)
  activeReadingSeconds Int      @default(0)
  watchedPercentage    Float    @default(0)
  completed            Boolean  @default(false)
  rewardClaimed        Boolean  @default(false)
  completedAt          DateTime?
  updatedAt            DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  content KnowledgeContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

// ─────────────────────────────────────────────
// Admin & Dynamic Customization Models
// ─────────────────────────────────────────────

enum CategoryType {
  MARKETPLACE
  LEARNING
}

model Category {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  type      CategoryType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  content   String
  isGlobal  Boolean  @default(true)
  userId    String?
  createdAt DateTime @default(now())
}

model Reward {
  id          String   @id @default(uuid())
  title       String
  description String
  pointsCost  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CommentStatus {
  ACTIVE
  HIDDEN
  DELETED
}

model Comment {
  id          String          @id @default(uuid())
  contentId   String
  userId      String
  parentId    String?
  content     String
  status      CommentStatus   @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  knowledgeContent KnowledgeContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[]        @relation("CommentReplies")
  reports          CommentReport[]

  @@index([contentId])
  @@index([userId])
  @@index([parentId])
  @@index([status])
}

model CommentReport {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Chatbot Conversation Models
// ─────────────────────────────────────────────

enum ChatMessageRole {
  USER
  MODEL
}

model ChatConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id             String          @id @default(uuid())
  conversationId String
  role           ChatMessageRole
  content        String
  createdAt      DateTime        @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

model Address {
  id                  String      @id @default(uuid())
  userId              String
  type                AddressType
  label               String?     // Contoh: Rumah Utama, Kantor Cabang

  recipientName       String
  recipientPhone      String      // Tipe data string (normalisasi 62)

  provinceId          String
  provinceName        String
  cityId              String
  cityName            String
  districtId          String
  districtName        String
  subDistrictId       String
  subDistrictName     String
  postalCode          String

  street              String
  notes               String?     // Catatan kurir (contoh: pagar hitam)

  latitude            Decimal?    // Decimal untuk akurasi peta
  longitude           Decimal?    // Decimal untuk akurasi peta

  placeId             String?     // ID Google Maps Place jika dibutuhkan

  isDefault           Boolean     @default(false)

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?   // Untuk Soft Delete

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@index([userId, deletedAt]) // Optimalisasi pencarian alamat aktif user
}

// ─────────────────────────────────────────────
// Region Master Data Models
// ─────────────────────────────────────────────

model Province {
  id        String    @id
  name      String
  regencies Regency[]

  @@index([name])
}

model Regency {
  id         String     @id
  provinceId String
  name       String
  province   Province   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  districts  District[]

  @@index([provinceId])
  @@index([name])
}

model District {
  id        String    @id
  regencyId String
  name      String
  regency   Regency   @relation(fields: [regencyId], references: [id], onDelete: Cascade)
  villages  Village[]

  @@index([regencyId])
  @@index([name])
}

model Village {
  id         String   @id
  districtId String
  name       String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([districtId])
  @@index([name])
}

// ─────────────────────────────────────────────
// Order & Order Item Models
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  EXPIRED
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  buyerId     String
  sellerId    String
  
  // Snapshot Seller
  sellerStoreName String
  sellerStoreSlug String
  sellerLogo      String?

  // Snapshot Alamat Pengiriman (Prefixed & Region IDs + Names)
  shippingRecipientName   String
  shippingRecipientPhone  String
  shippingProvinceId      String
  shippingProvinceName    String
  shippingCityId          String
  shippingCityName        String
  shippingDistrictId      String
  shippingDistrictName    String
  shippingSubDistrictId   String
  shippingSubDistrictName String
  shippingPostalCode      String
  shippingStreet          String
  shippingNotes           String?

  // Snapshot Pricing (Decimal) & Weight
  subtotal       Decimal   @db.Decimal(15, 2)
  shippingCost   Decimal   @default(0) @db.Decimal(15, 2)
  serviceFee     Decimal   @default(0) @db.Decimal(15, 2)
  discount       Decimal   @default(0) @db.Decimal(15, 2)
  insuranceFee   Decimal   @default(0) @db.Decimal(15, 2)
  applicationFee Decimal   @default(0) @db.Decimal(15, 2)
  grandTotal     Decimal   @db.Decimal(15, 2)
  totalWeight    Int       @default(0)

  // Status & Expiration
  orderStatus OrderStatus @default(PENDING_PAYMENT)
  expiredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer   User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller  User        @relation("SellerOrders", fields: [sellerId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([buyerId])
  @@index([sellerId])
  @@index([orderStatus])
  @@index([orderNumber])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  productSlug  String
  thumbnailUrl String?
  productPrice Decimal  @db.Decimal(15, 2)
  weight       Int      @default(0)
  quantity     Int
  subtotal     Decimal  @db.Decimal(15, 2)
  categoryId   String?
  categoryName String?
  unit         String?  @default("unit")
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// Payment Models
// ─────────────────────────────────────────────

enum PaymentProvider {
  XENDIT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

model Payment {
  id               String          @id @default(uuid())
  orderId          String          @unique
  provider         PaymentProvider @default(XENDIT)
  amount           Decimal         @db.Decimal(15, 2)
  status           PaymentStatus   @default(PENDING)

  // ── Identifier Fields ──────────────────────────────────────────────
  // referenceId      → Internal unique reference yang dihasilkan oleh sistem Loop Tani
  //                    dengan format: PAY-YYYYMMDD-XXXXXX (misal: PAY-20260724-AB12CD).
  //                    Dikirim ke Xendit sebagai `reference_id` pada Payments API v3.
  // paymentRequestId → ID payment request yang dikembalikan oleh provider (Xendit Payment Request ID).
  //                    Diisi setelah berhasil membuat payment request ke Xendit.
  // paymentId        → ID pembayaran aktual dari provider. Diisi saat callback webhook
  //                    diterima dan status pembayaran berubah menjadi SUCCEEDED.
  referenceId      String          @unique
  paymentRequestId String?         @unique
  paymentId        String?         @unique

  // ── Payment Channel ────────────────────────────────────────────────
  // paymentMethod dan providerCode HANYA diisi dari webhook callback.
  // Jangan pernah percaya value dari frontend.
  // Contoh: paymentMethod = "VIRTUAL_ACCOUNT", providerCode = "BCA"
  paymentMethod    String?         // QRIS, VIRTUAL_ACCOUNT, EWALLET, CREDIT_CARD, dll.
  providerCode     String?         // BCA, BNI, MANDIRI, OVO, DANA, SHOPEEPAY, dll.

  expiredAt         DateTime?
  paidAt            DateTime?
  failureReason     String?        // Alasan kegagalan: "Expired", "Card declined", "Fraud detected", dll.
  webhookReceivedAt DateTime?      // Timestamp saat webhook callback diterima. Berguna untuk audit.

  // Menyimpan seluruh response dari Xendit.
  // IMMUTABLE: jangan pernah di-update sebagian (merge).
  // Selalu overwrite dengan payload terakhir yang diterima dari provider.
  rawResponse      Json?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([referenceId])
  @@index([paymentRequestId])
  @@index([provider, status])
}
